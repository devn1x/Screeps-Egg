#!/usr/bin/env node
// Waits until the Screeps CLI accepts connections, so the CLI client can connect.
// Usage: wait-for-cli <port> [timeout in seconds, default 120]
const net = require('net');

const port = Number(process.argv[2]);
const timeout = Number(process.argv[3] || 120);
if (!port || !timeout) {
    console.error('Usage: wait-for-cli <port> [timeout in seconds]');
    process.exit(2);
}

console.log('Connecting Screeps CLI');

// Hard limit, so a connection attempt that never answers can't block forever
setTimeout(() => {
    console.error(`ERROR: Screeps CLI not reachable on port ${port} after ${timeout} seconds`);
    process.exit(1);
}, timeout * 1000);

function check() {
    const socket = net.connect(port, 'localhost');
    socket.setTimeout(5000, () => socket.destroy(new Error('timeout')));
    // Close the connection cleanly: exiting right away resets it, which crashes the backend
    socket.on('connect', () => socket.resume().end());
    socket.on('close', hadError => hadError || process.exit(0));
    socket.on('error', () => setTimeout(check, 1000));
}

check();
